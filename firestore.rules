rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admin check: skydj23@gmail.com OR role=admin OR custom claim OR adminConfig
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'skydj23@gmail.com' ||
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/adminConfig/main) &&
         request.auth.uid in get(/databases/$(database)/documents/adminConfig/main).data.adminUids)
      );
    }

    // Check if first-time setup (no adminConfig document exists yet)
    function isFirstTimeSetup() {
      return !exists(/databases/$(database)/documents/adminConfig/main);
    }

    // 0. Admin Configuration Collection
    match /adminConfig/{docId} {
      // Any authenticated user can read adminConfig (needed for login check)
      allow read: if isAuthenticated();
      // Admin can write; OR first-time setup (no doc exists yet) by any authenticated user
      allow write: if isAdmin() || (isFirstTimeSetup() && isAuthenticated());
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Client can create their own profile with role 'client'
      // Admin can create their own profile with role 'admin' on first-time setup
      allow create: if isAuthenticated() && request.auth.uid == userId && (
        request.resource.data.role == 'client' ||
        (request.resource.data.role == 'admin' && (isAdmin() || isFirstTimeSetup()))
      );
      allow update: if isAuthenticated() && request.auth.uid == userId && (
        request.resource.data.role == 'client' ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 2. Business Settings
    match /businessSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Equipment Catalogue
    match /equipment/{equipmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /items/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Quotations / Enquiries
    match /quotations/{quotationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 6. Reviews — public sees approved only; clients can create pending; admin moderates
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAuthenticated() && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Default deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

