rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email.lower() == 'skydj23@gmail.com' ||
         (request.auth.token.keys().hasAny(['admin']) && request.auth.token.admin == true));
    }

    // Equipment Images: readable by everyone; uploadable/deletable only by admin
    match /equipment/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /items/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Business Logo: readable by everyone; managed only by admin
    match /business/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Client Event Photos with Reviews:
    // Clients can upload event photos (images under 5MB)
    // Photos can be viewed publicly with approved reviews
    // Only Admin can delete
    match /reviews/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 5 * 1024 * 1024 &&
                       request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
